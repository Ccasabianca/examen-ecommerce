# copier en .env, aucune valeur secrète ne doit être commitée
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/exam1Db
# 32 caractères minimum : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
# nombre de proxys devant l'api : 0 en local, 1 derrière nginx ou render
TRUST_PROXY=0
LOG_LEVEL=info
GATEWAY_URL=http://localhost:8000
# même valeur dans backend, gateway, notifications et stock-management d'un environnement
INTERNAL_API_KEY=
GATEWAY_TIMEOUT_MS=90000
# destinataire des notifications de commande
ADMIN_NOTIFY_EMAIL=examen_3_11@mywatchbuddy.com
# cookie de session réservé au https : vrai par défaut en production, false pour docker compose en http
COOKIE_SECURE=
# échecs de connexion tolérés par compte et par adresse ip sur 15 minutes (10 par défaut)
RATE_LIMIT_AUTH_MAX=
# seed uniquement (node seeder.js)
ADMIN_USERNAME=admin
ADMIN_EMAIL=examen_3_11@mywatchbuddy.com
ADMIN_PASSWORD=
