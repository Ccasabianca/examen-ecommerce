# copier en .env, aucune valeur secrète ne doit être commitée
NODE_ENV=development
PORT=4003
# même base que le backend du même environnement (même uri)
MONGO_URI=mongodb://127.0.0.1:27017/exam1Db
# même valeur que dans le backend et le gateway du même environnement
INTERNAL_API_KEY=
TRUST_PROXY=0
LOG_LEVEL=info
