# copier en .env, aucune valeur secrète ne doit être commitée
NODE_ENV=development
PORT=4002
# même valeur que dans le backend et le gateway du même environnement
INTERNAL_API_KEY=
# smtp (envoi réel) ou log (aucun envoi, le mail est journalisé)
MAIL_TRANSPORT=smtp
# boîte hostinger : 465 en tls direct ; render gratuit bloque 25, 465 et 587 en sortie
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=examen_3_11@mywatchbuddy.com
SMTP_PASS=
SMTP_TIMEOUT_MS=15000
MAIL_FROM=Boutique <examen_3_11@mywatchbuddy.com>
TRUST_PROXY=0
LOG_LEVEL=info
