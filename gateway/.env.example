# copier en .env, aucune valeur secrète ne doit être commitée
NODE_ENV=development
# render impose PORT ; GATEWAY_PORT reste lu en local
GATEWAY_PORT=8000
NOTIFI_SERVICE_URL=http://localhost:4002
STOCK_SERVICE_URL=http://localhost:4003
# même valeur que dans le backend et les microservices du même environnement
INTERNAL_API_KEY=
PROXY_TIMEOUT_MS=90000
TRUST_PROXY=0
LOG_LEVEL=info
