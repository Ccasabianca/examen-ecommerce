# variables de docker compose (préproduction locale) : copier en .env, ne jamais commiter .env
# secrets : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
INTERNAL_API_KEY=

# smtp : mailpit par défaut (boîte de test locale sur http://localhost:8025)
# boîte hostinger : SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER, SMTP_PASS
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Boutique <examen_3_11@mywatchbuddy.com>
ADMIN_NOTIFY_EMAIL=examen_3_11@mywatchbuddy.com

# seed (docker compose exec backend node seeder.js)
ADMIN_USERNAME=admin
ADMIN_EMAIL=examen_3_11@mywatchbuddy.com
ADMIN_PASSWORD=

# ports publiés par docker compose (à changer si npm run start:all occupe déjà 3000 et 5000)
FRONT_PORT=3000
BACKEND_PORT=5000
